.env
*.pem
*.key

# Catalogs (40MB-2.2GB) and raw Amazon dumps (1.4-5GB) blow past GitHub's
# 100MB hard limit. Ignore every CSV/JSONL here by rule, so a new catalog
# variant can never be committed by accident; the small JSON eval fixtures
# (eval_queries, recipe_eval, stress_queries, sponsored, cross_sell_eval)
# are NOT matched and stay tracked.
data/*.csv
data/*.jsonl

.cache/

logs/

eval_results/

.claude/memory/
.claude/settings.local.json

__pycache__/
*.py[cod]
*.pyo
