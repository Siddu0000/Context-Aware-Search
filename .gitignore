# =============================================================
# SECRETS — never commit these under any circumstances
# =============================================================
.env
*.pem
*.key

# =============================================================
# LARGE DATA FILES — too big for GitHub (100MB file limit)
# Regenerate with: python -m scripts.load_amazon_data
# =============================================================
data/meta_*
data/products.csv
data/products_amazon.csv
data/products_grocery.csv
data/products_enhanced.csv
data/enhancement_checkpoint.jsonl

# =============================================================
# GENERATED / MACHINE-LOCAL — recreated on each machine
# =============================================================

# Embedding cache (rebuilt on first boot, ~200MB)
.cache/

# LLM logs and feedback
logs/

# Eval output CSVs (generated by running eval scripts)
eval_results/

# =============================================================
# CLAUDE CODE — local machine state; rules + CLAUDE.md ARE tracked
# =============================================================
.claude/memory/
.claude/settings.local.json

