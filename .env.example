# ====== Required ======================================================
GOOGLE_API_KEY=your_primary_gemini_key_here

# ====== Multi-key Gemini failover (Niharika's June 4 suggestion) ======
# Create extra free Gemini keys using DIFFERENT personal Gmail IDs.
# When the primary hits 429, the rotator falls back to these automatically.
# GOOGLE_API_KEY_2=your_second_gemini_key
# GOOGLE_API_KEY_3=your_third_gemini_key
# GOOGLE_API_KEY_4=
# GOOGLE_API_KEY_5=

# ====== LLM provider ==================================================
# gemini | openai | anthropic
LLM_PROVIDER=gemini

# Gemini model (recommend gemini-2.5-flash-lite for free tier — 1000 RPD).
GEMINI_MODEL=models/gemini-2.5-flash-lite

# Optional cross-provider keys (only needed if LLM_PROVIDER points there or
# you run eval/compare_llms.py against them).
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ====== Translator strategy ===========================================
# query_expansion | hyde | hybrid
TRANSLATOR_MODE=query_expansion

# ====== Determinism ===================================================
# When true: temperature is forced to 0 and a fixed seed is sent. This is
# what makes repeated identical queries reproducible. Set false for a
# "creative" mode (no seed, requested temperature used).
DETERMINISTIC=true
LLM_SEED=42
# TEMPERATURE_OVERRIDE is NOT set here — it is a runtime knob used only by
# eval/compare_temperature.py to sweep temperatures. Leave it unset in .env.

# ====== Response cache ================================================
# CACHING IS DISABLED in the current build (early-stage development).
# This env var is read but ignored — see app/config.py for context.
# Every /search hits the real LLM. To re-enable cache later, uncomment
# the cache blocks in app/translator.py, app/reranker.py, and app/main.py.
# CACHE_ENABLED=true

# ====== Retrieval =====================================================
NUM_INTENTS=3
RETRIEVAL_TOP_K=30
FINAL_TOP_K=10
RERANK_ENABLED=true

# ====== Embedding model ===============================================
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ====== Streamlit UI ==================================================
BACKEND_URL=http://127.0.0.1:8000

# ====== Rating-aware scoring ==========================================
# Bayesian rating blended into the final score. Weight in [0,1]:
#   0.0  = pure relevance, rating ignored
#   0.05 = relevance dominates (95%), rating is a faint tie-breaker  ← current
#   0.15 = rating nudges 15%
# Niharika asked to keep this "as minimal as possible" — set to 0.05.
RATING_BOOST_WEIGHT=0.05
