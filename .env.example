OPENAI_API_KEY=YOUR_GROQ_KEY_HERE
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
GROQ_REASONING_FORMAT=hidden

LLM_PROVIDER=openai

GOOGLE_API_KEY=YOUR_GEMINI_KEY_HERE
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GOOGLE_API_KEY_4=
GEMINI_MODEL=models/gemini-2.5-flash

TRANSLATOR_MODE=query_expansion

DETERMINISTIC=true
LLM_SEED=42

PAGE_CACHE_SIZE=64

NUM_INTENTS=3
RETRIEVAL_TOP_K=30
FINAL_TOP_K=12
RERANK_ENABLED=true
RERANK_INPUT_K=15

MIN_RESULT_RELEVANCE=0.28

EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBED_MAX_SEQ_LEN=128
EMBED_BATCH_SIZE=64

GROCERY_PER_INTENT_K=4

BACKEND_URL=http://127.0.0.1:8000

RATING_BOOST_WEIGHT=0.05

SPONSORED_ENABLED=true
