OPENAI_API_KEY=YOUR_GROQ_KEY_HERE
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
GROQ_REASONING_FORMAT=hidden
# Databricks path (set in notebook Cell 2, see databricks/README.md -- not in this file;
# the deployed App's values live in databricks/app_bundle/app.yaml):
# OPENAI_BASE_URL=https://<workspace-host>/serving-endpoints
# OPENAI_API_KEY=<Databricks token>
# key (default) = the static OPENAI_API_KEY above. databricks = a fresh workspace token
# from databricks-sdk before every call -- what a Databricks App needs, since its service
# principal's OAuth tokens last 1 hour. Requires openai>=1.106.
# OPENAI_AUTH=key
# OPENAI_MODEL=databricks-qwen3-next-80b-a3b-instruct   # decided 2026-09-24; revert: databricks-gpt-oss-120b
# `seed` is never sent to serving-endpoints (it 400s), and GROQ_REASONING_FORMAT is ignored there.

LLM_PROVIDER=openai

# Catalog to serve. Default: data/products_enriched.csv when it exists (cleaned +
# enriched by scripts/enrich_catalog.py; estimated prices are flagged, never shown
# as real), else data/products.csv. Set this to force the raw catalog:
# PRODUCTS_CSV=data/products.csv

GOOGLE_API_KEY=YOUR_GEMINI_KEY_HERE
GOOGLE_API_KEY_2=
GOOGLE_API_KEY_3=
GOOGLE_API_KEY_4=
GEMINI_MODEL=models/gemini-2.5-flash

TRANSLATOR_MODE=query_expansion

DETERMINISTIC=true
LLM_SEED=42

PAGE_CACHE_SIZE=64

NUM_INTENTS=3
# Prompt-injection guard (app/query_guard.py): the query is cut at its first instruction
# marker before any LLM sees it, and every LLM-written phrase is screened. Ordinary
# queries reach the LLM unchanged. false = the pre-2026-10-12 behaviour (the revert / A-B switch).
QUERY_GUARD_ENABLED=true
# Most intents (= retrieval calls) one query may fan out to while the guard is on;
# a long recipe reply listed 22 ingredients
MAX_INTENTS=24
RETRIEVAL_TOP_K=30
FINAL_TOP_K=12
RERANK_ENABLED=true
RERANK_INPUT_K=15

MIN_RESULT_RELEVANCE=0.28

# Embedding model. gte-small won both eval rounds; revert with all-MiniLM-L6-v2.
EMBEDDING_MODEL=thenlper/gte-small
EMBED_MAX_SEQ_LEN=128
EMBED_BATCH_SIZE=64

GROCERY_PER_INTENT_K=4

BACKEND_URL=http://127.0.0.1:8000

RATING_BOOST_WEIGHT=0.05

SPONSORED_ENABLED=true
# Flat-results ads need a rerank_score (0-100) above this; 40 = the prompt's
# constraint-violator ceiling. Bundle slots don't apply it (slot membership only).
# SPONSORED_MIN_RERANK_SCORE=40
# Type-aware ordering: a query that names a kind of product (clothes, shoes, earrings ...)
# ranks that type first inside a Fashion-majority pool, and outfit cards put garments
# first. false = the old ordering and the old reranker inputs (no [product_type]
# constraint, setting-only constraints kept, no pronoun gender); the gender-word fix,
# prompt edits, routing, the reranker's type= field and the same-type upsell need a git
# revert (see app/config.py).
TYPE_AWARE_RANKING=true

# Absolute "no products match" floor on the top retrieval score. On gte-small
# every query scores 0.83-0.94 (even gibberish ~0.85), so the floor never fires
# locally. The Vector Search scale differs: calibrate it with
# `python -m eval.calibrate_relevance` / databricks/07 before deploying.
MIN_RESULT_RELEVANCE=0.28

# Retrieval backend: local (gte-small + numpy) | databricks (Vector Search)
SEARCH_BACKEND=local
CAS_CATALOG=dev
CAS_SCHEMA=cas
CAS_ENDPOINT=cas-search
VS_EMBEDDING_MODEL=databricks-gte-large-en
# vector = embed queries in the app (self-managed index from databricks/02);
# text = query_text, only for an old MANAGED-embedding index
VS_QUERY_MODE=vector
# VS_INDEX=dev.cas.products_index
# Catalog file databricks/01 loads (and the Apps fallback when there is no Spark;
# the App itself reads /Volumes/dev/cas/raw/app_catalog.csv from 09 export_catalog())
# VS_CATALOG_CSV=/Volumes/dev/cas/raw/products_enriched.csv
# The Databricks App's name (databricks/09_deploy_app.py); fixes its URL
# CAS_APP_NAME=cas-app

# MLflow tracking (opt-in; needs `pip install mlflow`). Locally MLflow 3.x
# refuses the old ./mlruns file store -- point it at sqlite instead:
MLFLOW_ENABLED=false
# MLFLOW_EXPERIMENT=/Users/<you>/cas-evals
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
